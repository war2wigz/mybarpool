{
  "name": "mybarpool-workspace",
  "private": true,
  "license": "Apache-2.0",
  "description": "MyBarPool: the on-chain program and the client SDK. Workspace root for localnet tests.",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "workspaces": [
    "packages/shared"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "test:localnet": "vitest run --root tests",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck --workspaces",
    "format": "prettier --check \"**/*.{ts,json,md,yml,yaml}\"",
    "format:fix": "prettier --write \"**/*.{ts,json,md,yml,yaml}\""
  },
  "devDependencies": {
    "@solana/kit": "8.4.0",
    "@types/node": "26.6.3",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
