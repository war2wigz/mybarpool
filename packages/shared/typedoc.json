{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/index.ts"],
  "out": "docs-api",
  "excludeInternal": true,
  "excludePrivate": true,
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": true
  },
  "treatWarningsAsErrors": true,
  "readme": "README.md",
  "name": "@mybarpool/shared",
  "requiredToBeDocumented": [
    "Enum",
    "Variable",
    "Function",
    "Class",
    "Interface",
    "TypeAlias",
    "Method",
    "Accessor"
  ],
  "intentionallyNotExported": [
    "src/generated/accounts/platformConfig.ts:PlatformConfig",
    "src/generated/accounts/gameRecord.ts:GameRecord",
    "src/generated/accounts/pool.ts:Pool",
    "src/generated/accounts/creatorCounter.ts:CreatorCounter",
    "src/generated/accounts/walletOverride.ts:WalletOverride",
    "src/generated/accounts/sponsorship.ts:Sponsorship",
    "src/generated/types/tokenRule.ts:TokenRule",
    "src/generated/events/boxesBought.ts:BoxesBoughtEvent",
    "src/generated/events/boxesReclaimed.ts:BoxesReclaimedEvent",
    "src/generated/events/boxesReturned.ts:BoxesReturnedEvent",
    "src/generated/events/boxesSplit.ts:BoxesSplitEvent",
    "src/generated/events/configUpdated.ts:ConfigUpdatedEvent",
    "src/generated/events/digitsDrawn.ts:DigitsDrawnEvent",
    "src/generated/events/gameCreated.ts:GameCreatedEvent",
    "src/generated/events/gameMarked.ts:GameMarkedEvent",
    "src/generated/events/gateKeyRotated.ts:GateKeyRotatedEvent",
    "src/generated/events/kickoffUpdated.ts:KickoffUpdatedEvent",
    "src/generated/events/overrideClosed.ts:OverrideClosedEvent",
    "src/generated/events/overrideSet.ts:OverrideSetEvent",
    "src/generated/events/poolCancelled.ts:PoolCancelledEvent",
    "src/generated/events/poolClosed.ts:PoolClosedEvent",
    "src/generated/events/poolCreated.ts:PoolCreatedEvent",
    "src/generated/events/poolLocked.ts:PoolLockedEvent",
    "src/generated/events/quarterSettled.ts:QuarterSettledEvent",
    "src/generated/events/scoresPosted.ts:ScoresPostedEvent",
    "src/generated/events/sponsored.ts:SponsoredEvent",
    "src/generated/events/sponsorshipClosed.ts:SponsorshipClosedEvent",
    "src/generated/events/sponsorshipReturned.ts:SponsorshipReturnedEvent",
    "src/generated/events/varReplaced.ts:VarReplacedEvent",
    "src/generated/events/varSampled.ts:VarSampledEvent",
    "src/generated/events/varSet.ts:VarSetEvent"
  ]
}
